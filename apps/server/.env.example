PORT=3001
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Must be the public API URL. On Render use https://your-api.onrender.com
BETTER_AUTH_URL=http://localhost:3001
# From Better Auth Infrastructure dashboard (analytics / dash plugin) — optional
BETTER_AUTH_API_KEY=
# Frontend origins for cookies/CORS
CORS_ORIGIN=http://localhost:5174
TEACHER_ORIGIN=http://localhost:5174
STUDENT_ORIGIN=http://localhost:5173
# Optional. When set, parent-to-student invitations are emailed via Resend.
RESEND_API_KEY=
RESEND_MAIL_FROM=Kleva <hello@joinkleva.app>
# Optional. Site-wide preview password for student/teacher apps (default: unstablegeometry)
SITE_ACCESS_PASSWORD=unstablegeometry
# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
